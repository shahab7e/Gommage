<?xml version="1.0" encoding="utf-8"?>
<!-- Phones: the desktop Support page as one scrolling column. Same ids as the TV layout. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="48dp"
        android:paddingBottom="28dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/heartbox"
            android:elevation="10dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_heart_dark" />
        </FrameLayout>

        <TextView
            style="@style/T"
            android:layout_marginTop="16dp"
            android:fontVariationSettings="'wght' 700"
            android:text="Keep Gommage free"
            android:textSize="24sp" />

        <TextView
            style="@style/T"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:text="Gommage is built by one person, in spare time, for people who need a way around censorship. Filtering changes all the time, and every update takes hours of work. If it got you connected, a small donation keeps it alive."
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView style="@style/Perk" android:text="No ads" />
            <TextView style="@style/Perk" android:text="No tracking" />
            <TextView style="@style/Perk" android:layout_marginEnd="0dp" android:text="No account" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/card"
            android:orientation="horizontal"
            android:padding="4dp">

            <LinearLayout android:id="@+id/btc" style="@style/Coin">
                <ImageView android:id="@+id/btcIcon" style="@style/CoinIcon" android:src="@drawable/ic_btc" />
                <TextView style="@style/CoinText" android:text="Bitcoin" />
            </LinearLayout>

            <LinearLayout android:id="@+id/sol" style="@style/Coin">
                <ImageView android:id="@+id/solIcon" style="@style/CoinIcon" android:src="@drawable/ic_sol" />
                <TextView style="@style/CoinText" android:text="Solana" />
            </LinearLayout>

            <LinearLayout android:id="@+id/bnb" style="@style/Coin">
                <ImageView android:id="@+id/bnbIcon" style="@style/CoinIcon" android:src="@drawable/ic_bnb" />
                <TextView style="@style/CoinText" android:text="BNB" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:id="@+id/qr"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:background="@drawable/qrframe"
                android:contentDescription="Wallet QR code"
                android:elevation="8dp"
                android:padding="12dp" />

            <TextView
                android:id="@+id/net"
                style="@style/T"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.05"
                android:textColor="#8E95A6"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/addr"
                style="@style/T"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/copy"
                style="@style/Pill"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:background="@drawable/heartbox"
                android:text="Copy address"
                android:textColor="#3A2208" />
        </LinearLayout>

        <TextView
            style="@style/T"
            android:layout_marginTop="16dp"
            android:text="Any amount helps. Thank you 💛"
            android:textColor="#8E95A6"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
