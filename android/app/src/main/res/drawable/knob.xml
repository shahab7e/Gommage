<?xml version="1.0" encoding="utf-8"?>
<!-- the desktop app's knob; a white ring shows where the remote is -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="40dp" />
            <gradient android:angle="270" android:startColor="#5a616e" android:endColor="#3a3f49" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="40dp" />
            <gradient android:angle="270" android:startColor="#4a505c" android:endColor="#31353e" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>
