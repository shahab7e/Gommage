<?xml version="1.0" encoding="utf-8"?>
<!-- the desktop flags' highlight: light top-left, shade at the bottom, thin rim -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><gradient android:type="radial" android:centerX="0.3" android:centerY="0.25"
        android:gradientRadius="45%p" android:startColor="#59FFFFFF" android:endColor="#00FFFFFF" /></shape></item>
    <item><shape android:shape="oval"><gradient android:type="radial" android:centerX="0.5" android:centerY="1.2"
        android:gradientRadius="60%p" android:startColor="#40000000" android:endColor="#00000000" /></shape></item>
    <item><shape android:shape="oval"><stroke android:width="1dp" android:color="#1FFFFFFF" /></shape></item>
</layer-list>
